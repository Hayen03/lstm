  "symbols": [
    "O{r: 3, c: #FFFFFF}",
    "V{s: 12}",
    "K{r: 5}",
    "J{r: 8}",
    "B{a: 0}",
    "A{a: 0}",
    "T{d: 0,v: 1}",
    "G{a: 0}",
    "w{a: 0}"
  ],
  "drawing": [
    {
      "from": "O",
      "to": "[C{color: c}M{length: -r}L{size: r}]"
    },
    {
      "from": "V",
      "to": "[C{color: #549B64}(F{length: s, width: 1}R{deg: 135}F{length: s*0.707107, width: 1}R{deg: 90}F{length: s*0.707107, width: 1})]"
    },
    {
      "from": "K",
      "to": "[R{deg: 0}M{length: r}O{r: r, c: #FFF1DB}][R{deg: 72}M{length: r}O{r: r, c: #FFF1DB}][R{deg: 144}M{length: r}O{r: r, c: #FFF1DB}][R{deg: 216}M{length: r}O{r: r, c: #FFF1DB}][R{deg: 288}M{length: r}O{r: r, c: #FFF1DB}]O{r: r*0.5,c: #F2B84B}"
    },
    {
      "from": "J",
      "to": "[H{rot: 0}M{length: -r*0.35}O{r: r*0.78,c: #D94F47}M{length: r*0.7}O{r: r*0.78,c: #ED6452}H{rot: 90}M{length: r*0.6}C{color: #71503B}F{length: r*0.55,width: 2}[R{deg: -55}V{s: r*0.8}]]"
    },
    {
      "from": "B",
      "to": "[K{r: 2.5+min(6,max(0,a))*0.55}]"
    },
    {
      "from": "A",
      "to": "[J{r: 2+a*0.55}]"
    },
    {
      "from": "T",
      "to": "[P{y: let p = pos() ?? [0.0, 0.0] for p[1]-d}J{r: 8.6}]"
    },
    {
      "from": "G",
      "to": "[P{y: ground+max(1,8.6-a*0.65)}J{r: max(1,8.6-a*0.65)}]"
    },
    {
      "from": "w",
      "to": ""
    }
  ],
  "rules": [
    {
      "from": "B",
      "to": "A{a: 0}",
      "cond": "a>=6"
    },
    {
      "from": "B",
      "to": "B{a:a+1}",
      "cond": "a<6"
    },
    {
      "from": "A",
      "to": "T{d:0,v:1}",
      "cond": "a>=12"
    },
    {
      "from": "A",
      "to": "A{a:a+1}",
      "cond": "a<12"
    },
    {
      "from": "T",
      "to": "G{a:0}",
      "cond": "d>=(let p = pos() ?? [0.0, 0.0] for p[1]-ground-8.6)"
    },
    {
      "from": "T",
      "to": "T{d:min(d+v,let p = pos() ?? [0.0, 0.0] for p[1]-ground-8.6),v:v+1.6}",
      "cond": "d<(let p = pos() ?? [0.0, 0.0] for p[1]-ground-8.6)"
    },
    {
      "from": "G",
      "to": "w{a:0}",
      "cond": "a>=11"
    },
    {
      "from": "G",
      "to": "G{a:a+1}",
      "cond": "a<11"
    },
    {
      "from": "w",
      "to": "B{a:0}",
      "cond": "a>=8"
    },
    {
      "from": "w",
      "to": "w{a:a+1}",
      "cond": "a<8"
    }
  ]
}
