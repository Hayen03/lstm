  "symbols": [
    "O{r: 3, c: #FFFFFF}",
    "E{a:0,vx:1,vy:10}",
    "U{x:0,y:0,vx:1,vy:10,h:90}"
  ],
  "drawing": [
    {
      "from": "O",
      "to": "[C{color: c}M{length: -r}L{size: r}]"
    },
    {
      "from": "E",
      "to": ""
    },
    {
      "from": "U",
      "to": "[P{x:x-vx*1.8,y:screen()[1]/2+(y-vy*1.8)}O{r:1.4,c:#367F9F}P{x:x-vx,y:screen()[1]/2+(y-vy)}O{r:2,c:#61C4DE}P{x:x,y:screen()[1]/2+(y)}H{rot:h}O{r:3,c:#D7FCFF}]"
    }
  ],
  "rules": [
    {
      "from": "E",
      "to": "E{a:a+1,vx:vx,vy:vy}",
      "cond": "a<8"
    },
    {
      "from": "E",
      "to": "U{x:pos()[0],y:(pos()[1]-screen()[1]/2),vx:vx,vy:vy,h:heading()}",
      "cond": "a>=8"
    },
    {
      "from": "U",
      "to": "E{a:0,vx:vx,vy:19-abs(vx/0.34)*0.12}",
      "cond": "y<=floor+4 && vy<0"
    },
    {
      "from": "U",
      "to": "U{x:x+vx,y:y+vy,vx:vx,vy:vy-0.55,h:h}",
      "cond": "y>floor+4 || vy>=0"
    }
  ]
}
