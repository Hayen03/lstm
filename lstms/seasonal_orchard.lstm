// Canvas origin: bottom center. Geometry data stays center-relative; P/D add screen()[1]/2.
{
  "name": "Wild orchard \u2014 seasons and competition",
  "description": "A stochastic plant life cycle with seasonal germination and previous-frame root competition. Use animation.",
  "recommended_iterations": 600,
  "bg": "#192C30",
  "globals": {
    "ground": "-230",
    "habitat": "400",
    "germination": "0.50",
    "drift": "0.65",
    "gravity": "0.8",
    "stem_life": "84",
    "yellow_age": "48",
    "flower_time": "7",
    "ripen_time": "15",
    "decay_time": "12",
    "dormancy": "8",
    "season_length": "120",
    "spring_length": "90",
    "root_spacing": "52",
    "competition": "0.65",
    "season": "fn t -> (t % season_length) < spring_length",
    "neighbors": "fn x -> max(0,marked().filter(fn m -> abs(m.x-x)<root_spacing).map(fn m -> m.w).sum()-0.15)",
    "chance": "fn x -> germination / (1+competition*neighbors(x))"
  },
  "axiom": "ZN{x:-270}A{x:-270,y:ground,h:90,l:14+random()*5,id:0}N{x:-90}A{x:-90,y:ground,h:90,l:14+random()*5,id:1}N{x:90}A{x:90,y:ground,h:90,l:14+random()*5,id:2}N{x:270}A{x:270,y:ground,h:90,l:14+random()*5,id:3}",
  "symbols": [
    "Z",
    "O{r:3,c:#FFFFFF}",
    "V{s:10,c:#6EAD69}",
    "K{r:3}",
    "A{x:0,y:ground,h:90,d:0,n:0,id:0,l:12}",
    "B{x:0,y:0,h:90,l:12,d:0,a:0,id:0}",
    "E{x:0,y:0,a:0,id:0}",
    "U{x:0,y:0,a:0,id:0}",
    "T{x:0,y:0,v:0,vx:0,id:0}",
    "G{x:0,a:0,id:0}",
    "Q{x:0,a:0,u:0,id:0}",
    "w{x:0,a:0}",
    "N{x:0,a:0}",
    "I{x:0,u:0,p:0,id:0}"
  ],
  "drawing": [
    {
      "from": "Z",
      "to": "[P{x:-habitat,y:screen()[1]/2+(ground)}H{rot:0}C{color:#59754C}F{length:habitat*2,width:4}][P{x:-habitat,y:screen()[1]/2+(ground-13)}H{rot:0}C{color:#8AA761 if season(gen()) else #4C6573}F{length:habitat*2*((gen()%season_length)/season_length),width:2}]"
    },
    {
      "from": "O",
      "to": "[C{color:c}M{length:-r}L{size:r}]"
    },
    {
      "from": "V",
      "to": "[C{color:c}(F{length:s,width:1}R{deg:135}F{length:s*0.707107,width:1}R{deg:90}F{length:s*0.707107,width:1})]"
    },
    {
      "from": "K",
      "to": "[R{deg:0}M{length:r}O{r:r,c:#FFE7B2}][R{deg:72}M{length:r}O{r:r,c:#FFE7B2}][R{deg:144}M{length:r}O{r:r,c:#FFE7B2}][R{deg:216}M{length:r}O{r:r,c:#FFE7B2}][R{deg:288}M{length:r}O{r:r,c:#FFE7B2}]O{r:r*0.5,c:#D99840}"
    },
    {
      "from": "A",
      "to": "[P{x:x,y:screen()[1]/2+(y)}H{rot:h}O{r:2.2,c:#B5D987}]"
    },
    {
      "from": "B",
      "to": "P{x:x,y:screen()[1]/2+(y)}H{rot:h}C{color:#579257 if a<yellow_age else #9A794E}F{length:l,width:max(0.5,(3.5-d*0.65)*min(1,(stem_life-a)/15))}[R{deg:-45}V{s:max(0.3,(12-d)*min(1,(stem_life-a)/25)),c:#74B16B if a<yellow_age else #B09350}][R{deg:50}V{s:max(0.3,(9-d)*min(1,(stem_life-a)/25)),c:#589962 if a<yellow_age else #8B7348}]"
    },
    {
      "from": "E",
      "to": "[P{x:x,y:screen()[1]/2+(y)}K{r:2+min(a,6)*0.35}]"
    },
    {
      "from": "U",
      "to": "[P{x:x,y:screen()[1]/2+(y)}O{r:2+min(a,12)*0.42,c:#86AE59 if a<7 else (#E3B954 if a<12 else #D96947)}H{rot:90}M{length:2+min(a,12)*0.42}C{color:#6E7044}F{length:3,width:1}]"
    },
    {
      "from": "T",
      "to": "[P{x:x,y:screen()[1]/2+(y)}O{r:7,c:#D96947}]"
    },
    {
      "from": "G",
      "to": "[P{x:x,y:screen()[1]/2+(ground+max(1,7-a*0.5))}O{r:max(1,7-a*0.5),c:#9A6643 if a<6 else #66583D}]"
    },
    {
      "from": "Q",
      "locals": {
        "record": "mark({'x':x,'w':0.15})"
      },
      "to": "[P{x:x,y:screen()[1]/2+(ground+1.5)}O{r:1.5,c:#E2CB86}]"
    },
    {
      "from": "w",
      "to": "[P{x:x,y:screen()[1]/2+(ground+1)}O{r:max(0.2,1-a*0.12),c:#6D704C}]"
    },
    {
      "from": "N",
      "locals": {
        "record": "mark({'x':x,'w':1})"
      },
      "to": ""
    },
    {
      "from": "I",
      "locals": {
        "record": "mark({'x':x,'w':0.15})"
      },
      "to": "[P{x:x,y:screen()[1]/2+(ground+1.5)}O{r:1.5,c:#E2CB86}]"
    }
  ],
  "rules": [
    {
      "from": "A",
      "to": "B{x:x,y:y,h:h,l:l,d:d,a:d*8+n*2,id:id}A{x:pos()[0],y:(pos()[1]-screen()[1]/2),h:heading(),d:d,n:n+1,id:id,l:l}",
      "cond": "n<2",
      "name": "A: extend shoot"
    },
    {
      "from": "A",
      "to": "B{x:x,y:y,h:h,l:l,d:d,a:d*8+n*2,id:id}A{x:pos()[0],y:(pos()[1]-screen()[1]/2),h:h+22+random()*10,d:d+1,n:0,id:id,l:l*(0.76+random()*0.12)}A{x:pos()[0],y:(pos()[1]-screen()[1]/2),h:h-22-random()*10,d:d+1,n:0,id:id,l:l*(0.76+random()*0.12)}",
      "cond": "n>=2 && d==0",
      "name": "A: first fork"
    },
    {
      "from": "A",
      "to": "B{x:x,y:y,h:h,l:l,d:d,a:d*8+n*2,id:id}A{x:pos()[0],y:(pos()[1]-screen()[1]/2),h:h+22+random()*10,d:d+1,n:0,id:id,l:l*(0.76+random()*0.12)}A{x:pos()[0],y:(pos()[1]-screen()[1]/2),h:h-22-random()*10,d:d+1,n:0,id:id,l:l*(0.76+random()*0.12)}",
      "cond": "n>=2 && d>0 && d<3",
      "weight": 73,
      "name": "A: fork"
    },
    {
      "from": "A",
      "to": "B{x:x,y:y,h:h,l:l,d:d,a:d*8+n*2,id:id}A{x:pos()[0],y:(pos()[1]-screen()[1]/2),h:h+(random()-0.5)*14,d:d+1,n:0,id:id,l:l*0.82}",
      "cond": "n>=2 && d>0 && d<3",
      "weight": 27,
      "name": "A: continue single shoot"
    },
    {
      "from": "A",
      "to": "B{x:x,y:y,h:h,l:l,d:d,a:d*8+n*2,id:id}E{x:pos()[0],y:(pos()[1]-screen()[1]/2),id:id}",
      "cond": "n>=2 && d>=3",
      "name": "A: flower tip"
    },
    {
      "from": "B",
      "to": "B{x:x,y:y,h:h,l:l,d:d,a:a+1,id:id}",
      "cond": "a<stem_life",
      "name": "B: age stem"
    },
    {
      "from": "B",
      "to": "",
      "cond": "a>=stem_life",
      "name": "B: remove dead stem"
    },
    {
      "from": "E",
      "to": "E{x:x,y:y,a:a+1,id:id}",
      "cond": "a<flower_time",
      "name": "E: develop flower"
    },
    {
      "from": "E",
      "to": "U{x:x,y:y,id:id}",
      "cond": "a>=flower_time",
      "name": "E: set fruit"
    },
    {
      "from": "U",
      "to": "U{x:x,y:y,a:a+1,id:id}",
      "cond": "a<ripen_time",
      "name": "U: ripen fruit"
    },
    {
      "from": "U",
      "to": "T{x:x,y:y,v:0.8,vx:(random()-0.5)*drift*2,id:id}",
      "cond": "a>=ripen_time",
      "name": "U: drop fruit"
    },
    {
      "from": "T",
      "to": "T{x:x+vx,y:max(ground+7,y-v),v:v+gravity,vx:vx,id:id}",
      "cond": "y>ground+7",
      "name": "T: fall"
    },
    {
      "from": "T",
      "to": "G{x:x,id:id}",
      "cond": "y<=ground+7",
      "name": "T: land"
    },
    {
      "from": "G",
      "to": "G{x:x,a:a+1,id:id}",
      "cond": "a<decay_time",
      "name": "G: decay fruit"
    },
    {
      "from": "G",
      "to": "Q{x:x,u:random(),id:id}",
      "cond": "a>=decay_time",
      "name": "G: release seed"
    },
    {
      "from": "w",
      "to": "w{x:x,a:a+1}",
      "cond": "a<8",
      "name": "w: fade seed"
    },
    {
      "from": "w",
      "to": "",
      "cond": "a>=8",
      "name": "w: remove seed"
    },
    {
      "name": "Root census",
      "from": "N",
      "cond": "a<stem_life",
      "to": "N{x:x,a:a+1}"
    },
    {
      "name": "Root dies",
      "from": "N",
      "cond": "a>=stem_life",
      "to": ""
    },
    {
      "name": "Seed dormancy",
      "from": "Q",
      "cond": "a<dormancy || !season(gen())",
      "to": "Q{x:x,a:a+1,u:u,id:id}"
    },
    {
      "name": "Assess seed site once",
      "from": "Q",
      "cond": "a>=dormancy && season(gen())",
      "to": "I{x:x,u:u,p:chance(x),id:id}"
    },
    {
      "name": "Seed sprouts",
      "from": "I",
      "cond": "u<p && abs(x)<habitat",
      "to": "N{x:x}A{x:x,y:ground,h:85+random()*10,l:14+random()*5,id:random()}"
    },
    {
      "name": "Seed fails",
      "from": "I",
      "cond": "u>=p || abs(x)>=habitat",
      "to": "w{x:x}"
    }
  ],
  "seed": "orchard-2026"
}
