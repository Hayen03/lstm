  "rules": [
    {
      "name": "Runner makes a side shoot",
      "from": "V",
      "cond": "i<46 && i%10==4 && i>10 && i<35",
      "to": "B{x:x,y:y,h:(0 if side==1 else 180)+side*([0,9,18,26,30,26,18,9,0,-9,-18,-26,-30,-26,-18,-9,0,5][(i+(3 if side==-1 else 0))%18] if i<36 else (i-36)*14),l:8 if i<36 else 6,w:max(1.5,4-i*0.05)}N{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),h:60 if side==1 else 120,s:16+(i%3)*3,c:#698B49}[T{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),h:280 if side==1 else 260,turn:26*side}][w{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),h:(75 if side==1 else 105) if i!=14 else (285 if side==1 else 255),turn:11*side if i!=14 else -11*side}]V{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),side:side,i:i+1}"
    },
    {
      "name": "Runner makes a leaf and tendril",
      "from": "V",
      "cond": "i<46 && i%5==4 && !(i%10==4 && i>10 && i<35)",
      "to": "B{x:x,y:y,h:(0 if side==1 else 180)+side*([0,9,18,26,30,26,18,9,0,-9,-18,-26,-30,-26,-18,-9,0,5][(i+(3 if side==-1 else 0))%18] if i<36 else (i-36)*14),l:8 if i<36 else 6,w:max(1.5,4-i*0.05)}N{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),h:60 if side==1 else 120,s:16+(i%3)*3,c:#698B49}[T{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),h:280 if side==1 else 260,turn:26*side}]V{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),side:side,i:i+1}"
    },
    {
      "name": "Runner creeps then curls at its tip",
      "from": "V",
      "cond": "i<46 && i%5!=4",
      "to": "B{x:x,y:y,h:(0 if side==1 else 180)+side*([0,9,18,26,30,26,18,9,0,-9,-18,-26,-30,-26,-18,-9,0,5][(i+(3 if side==-1 else 0))%18] if i<36 else (i-36)*14),l:8 if i<36 else 6,w:max(1.5,4-i*0.05)}V{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),side:side,i:i+1}"
    },
    {
      "name": "Runner finishes",
      "from": "V",
      "cond": "i>=46",
      "to": "N{x:x,y:y,h:90,s:8}"
    },
    {
      "name": "Side shoot unfurls a leaf",
      "from": "w",
      "cond": "j<29 && (j==5 || j==15)",
      "to": "B{x:x,y:y,h:h,l:9*pow(0.98,j),w:1.8}N{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),h:h-55,s:16,c:#77914E}e{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),s:2.8}w{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),h:h+turn,j:j+1,turn:turn}"
    },
    {
      "name": "Side shoot curls",
      "from": "w",
      "cond": "j<29 && j!=5 && j!=15",
      "to": "B{x:x,y:y,h:h,l:9*pow(0.98,j),w:1.8}w{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),h:h+turn,j:j+1,turn:turn}"
    },
    {
      "name": "Finish side shoot",
      "from": "w",
      "cond": "j>=29",
      "to": ""
    },
    {
      "name": "Tendril winds into a spiral",
      "from": "T",
      "cond": "j<23",
      "to": "B{x:x,y:y,h:h,l:5*pow(0.91,j),w:0.8,c:#A9B96A}T{x:pos()[0]/scale(),y:(pos()[1]-screen()[1]/2)/scale(),h:h+turn,j:j+1,turn:turn}"
    },
    {
      "name": "Finish tendril",
      "from": "T",
      "cond": "j>=23",
      "to": ""
    },
    {
      "name": "Leaf expands",
      "from": "N",
      "cond": "a<12",
      "to": "N{x:x,y:y,h:h,s:s,a:a+1,c:c}"
    },
    {
      "name": "Flower opens",
      "from": "b",
      "cond": "a<12",
      "to": "b{a:a+1}"
    },
    {
      "name": "Flower sets a pumpkin",
      "from": "b",
      "cond": "a>=12",
      "to": "p{a:0}"
    },
    {
      "name": "Pumpkin swells and ripens",
      "from": "p",
      "cond": "a<44",
      "to": "p{a:a+1}"
    },
    {
      "name": "A face begins to appear",
      "from": "p",
      "cond": "a>=44",
      "to": "k{a:45}"
    },
    {
      "name": "Lantern grows into its grin",
      "from": "k",
      "cond": "a<76",
      "to": "k{a:a+1}"
    }
  ]
