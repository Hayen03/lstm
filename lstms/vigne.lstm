// Rameau de vigne ornemental : tiges en volutes, feuilles de vigne lobées,
// vrilles enroulées terminées par une perle. Palette vert olive / jaune-vert.
{
  name: "Rameau de vigne en volutes",
  description: "Tiges spiralées portant feuilles de vigne, rameaux et vrilles.",
  recommended_iterations: 32,
  bg: "#FFFFFF",

  // Trois tiges partent du bas : une sombre et épaisse, une olive, une claire
  // qui s'enroule vers la droite. P et H placent chaque départ.
  axiom: "[C{color: #27320E}P{y: -280}H{rot: 125}\
            A{n: 30, l: 17, w: 11, k: 1.0, c: #27320E}]\
          [C{color: #7B8122}P{x: 12, y: -280}H{rot: 112}\
            A{n: 24, l: 15, w: 6, k: 1.3, c: #7B8122}]\
          [C{color: #A9A644}P{x: 22, y: -280}H{rot: 40}\
            A{n: 14, l: 13, w: 4, k: -1.4, c: #A9A644}]",

  symbols: [
    // A : apex d'une tige principale (i : rang du segment, k : courbure)
    "A{i: 0, n: 30, l: 16, w: 8, k: 1.0, c: #27320E}",
    // B : apex d'un rameau secondaire qui s'enroule dans le sens d
    "B{n: 4, d: 1, l: 9, w: 2, c: #7B8122}",
    // K : feuille de vigne de taille s et de couleur c
    "K{s: 20, c: #C2BE62}",
    // T : vrille en spirale, E : bord dentelé d'un lobe, Z : perle
    "T{n: 28, l: 4, a: 12, w: 1.5, c: #7B8122}",
    "E{a: 8}",
    "Z{r: 2, c: #7B8122}",
  ],

  rules: [
    // Croissance d'une tige : un segment par génération, la courbure
    // augmente avec i pour former une volute ; un organe latéral alterne
    // de côté à chaque segment.
    {
      name: "tige + feuille",
      from: "A", cond: "i < n - 5", weight: 3,
      locals: {
        tour: "k * (4.0 + 0.026 * i * i)",
        cote: "1 if i % 2 == 0 else -1",
        teinte: "[#C9C46A, #C9C46A, #B4B04E, #B4B04E, #A2A03A, #D9D592, #D9D592, #4F5A18][dice(1, 8) - 1]",
      },
      to: "C{color: c}F{length: l, width: w}R{deg: tour}\
           [R{deg: cote * 60}F{length: 4 + l * 0.4, width: max(1, w * 0.25)}\
            K{s: 9 + l * 1.1, c: teinte}]\
           A{i: i + 1, n: n, l: l * 0.965, w: max(1.5, w * 0.93), k: k, c: c}",
    },
    {
      name: "tige + rameau",
      from: "A", cond: "i > 2 and i < n - 5", weight: 3,
      locals: {
        tour: "k * (4.0 + 0.026 * i * i)",
        cote: "1 if i % 2 == 0 else -1",
      },
      to: "C{color: c}F{length: l, width: w}R{deg: tour}\
           [R{deg: cote * 38}\
            B{n: 3 + dice(1, 3), d: cote, l: l * 0.75, w: max(1, w * 0.35),\
              c: [#7B8122, #A9A644, #3A4514][dice(1, 3) - 1]}]\
           A{i: i + 1, n: n, l: l * 0.965, w: max(1.5, w * 0.93), k: k, c: c}",
    },
    {
      name: "tige + vrille",
      from: "A", cond: "i < n", weight: 2,
      locals: {
        tour: "k * (4.0 + 0.026 * i * i)",
        cote: "1 if i % 2 == 0 else -1",
      },
      to: "C{color: c}F{length: l, width: w}R{deg: tour}\
           [R{deg: cote * 45}\
            T{n: 18 + dice(1, 12), l: 2.0 + l * 0.2, a: cote * 9, w: 1.2, c: c}]\
           A{i: i + 1, n: n, l: l * 0.965, w: max(1.5, w * 0.93), k: k, c: c}",
    },
    {
      name: "tige nue",
      from: "A", cond: "i < n", weight: 1,
      locals: {tour: "k * (4.0 + 0.026 * i * i)"},
      to: "C{color: c}F{length: l, width: w}R{deg: tour}\
           A{i: i + 1, n: n, l: l * 0.965, w: max(1.5, w * 0.93), k: k, c: c}",
    },
    // Fin de tige : elle se termine par une vrille serrée.
    {
      name: "volute finale",
      from: "A", cond: "i >= n",
      to: "T{n: 30, l: l * 0.5, a: (1 if k > 0 else -1) * 13, w: max(1, w * 0.7), c: c}",
    },

    // Rameau secondaire : quelques segments qui s'incurvent, portant
    // parfois une petite feuille, puis une vrille.
    {
      from: "B{n: fn x -> x > 0}", weight: 2,
      to: "C{color: c}F{length: l, width: w}R{deg: d * 14}\
           [R{deg: -d * 55}F{length: 3, width: 1}\
            K{s: 7 + l * 1.3, c: [#C9C46A, #B4B04E, #D9D592][dice(1, 3) - 1]}]\
           B{n: n - 1, d: d, l: l * 0.9, w: max(0.8, w * 0.85), c: c}",
    },
    {
      from: "B{n: fn x -> x > 0}", weight: 1,
      to: "C{color: c}F{length: l, width: w}R{deg: d * 18}\
           B{n: n - 1, d: d, l: l * 0.9, w: max(0.8, w * 0.85), c: c}",
    },
    {
      from: "B{n: 0}",
      to: "T{n: 22 + dice(1, 10), l: l * 0.5, a: d * 11, w: w, c: c}",
    },
  ],

  drawing: [
    // Vrille : la longueur diminue et l'angle augmente, d'où la spirale.
    {
      from: "T{n: fn x -> x > 0}",
      to: "C{color: c}F{length: l, width: w}R{deg: a}\
           T{n: n - 1, l: l * 0.93, a: a * 1.05, w: max(0.6, w * 0.96), c: c}",
    },
    {from: "T{n: 0}", to: "Z{r: 1.8, c: c}"},

    // Feuille de vigne : étoile régulière à cinq lobes, dont le sinus de
    // départ accueille le pétiole, remplie et aux bords dentelés.
    {
      from: "K",
      locals: {a: "s * 0.44"},
      to: "[C{color: c}R{deg: -120}(\
           E{a: a}R{deg: 132}E{a: a}R{deg: -60}\
           E{a: a}R{deg: 132}E{a: a}R{deg: -60}\
           E{a: a}R{deg: 132}E{a: a}R{deg: -60}\
           E{a: a}R{deg: 132}E{a: a}R{deg: -60}\
           E{a: a}R{deg: 132}E{a: a})]",
    },
    {
      from: "E",
      to: "R{deg: -18}F{length: a * 0.53, width: 0.6}\
           R{deg: 36}F{length: a * 0.53, width: 0.6}R{deg: -18}",
    },

    // Bourgeon d'une tige encore en croissance.
    {from: "A", to: "Z{r: max(1.5, w * 0.3), c: c}"},
    {from: "B", to: "Z{r: 1.5, c: c}"},

    // Perle centrée sur la position courante (macro de la section 5.3).
    {from: "Z", to: "[C{color: c}M{length: -r}L{size: r}]"},
  ],
}
